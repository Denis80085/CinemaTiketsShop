@model IEnumerable<Actor>

@{
    ViewData["Title"] = "List of actors";
}

<div class="row d-flex justify-content-center align-items-center">
    <div class="col-md-8">
        <div class="table-responsive">
            <table class="table-dark">
                <thead>
                    <tr class="text-center border-bottom">
                        <th class="border-end">@Html.DisplayNameFor(Model => Model.FotoURL)</th>
                        <th class="border-end">@Html.DisplayNameFor(Model => Model.Name)</th>
                        <th class="border-end">@Html.DisplayNameFor(Model => Model.Bio)</th>
                        <th>Actions</th>
                    </tr>
                    <tr style="height:10px"></tr>
                </thead>

                <tbody>
                    @foreach(var item in Model)
                    {
                        <tr>
                            <td class="align-middle border-end">
                                <img class="rounded-circle" src="@item.FotoURL" alt="@item.Name" style="max-width: 250px" />
                            </td>

                            <td class="text-center border-end">
                                @Html.DisplayFor(modelitem => item.Name)
                            </td>

                            <td class="text-center border-end">
                                @Html.DisplayFor(modelitem  =>  item.Bio)
                            </td>

                            <td class="align-middle">
                                <div class="d-flex flex-row justify-content-between">
                                    <a class="btn btn-primary" asp-controller="Actors" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil-square">Edit</i></a>
                                    <a class="btn btn-info" asp-controller="Actors" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-eye" style="color:white">Details</i></a>
                                    <a class="btn btn-danger text-white" asp-controller="Actors" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash">Delete</i></a>
                                </div>
                            </td>
                        </tr>
                        <tr style="height:10px"></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
</div>

<div class="text-white" style="position: fixed; right: 25px; bottom: 80px;">
    <a class="btn btn-success" asp-controller="Actors" asp-action="Create"> <i class="bi bi-clipboard2-plus"></i> Add new </a>
</div>

<style>
    tr {
        background-color: #343a40;
    }

    td {
        padding: 5px;
    }

    tr.border-bottom {
        border-bottom: 2px solid #d3d3d3 !important;
    }

    th.border-end,
    td.border-end {
        border-color: #d3d3d3 !important;
    }
</style>